#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    /*
     * MANUAL CONFIGURATION REQUIRED: Conditional Layers
     * --------------------------------------------------
     * Error: zmk,conditional-layers has source-specific timing or behavior; automatic conversion is not available.
     *
     * How to configure manually in your software:
     * - Feature: Conditional Layers / Tri-Layer
     * - Trigger Condition (if-layers): Both LOWER (Layer 1) and RAISE (Layer 2) active
     * - Target Layer (then-layer): ADJUST (Layer 3)
     * - Behavior: When both LOWER and RAISE momentary keys (&mo LOWER and &lt RAISE BACKSPACE)
     *   are pressed simultaneously, the ADJUST layer automatically activates (for BT, RGB, Power controls).
     *   Releasing either key drops back to the remaining held layer.
     */
    /*
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
    */

    behaviors {
        /*
         * MANUAL CONFIGURATION REQUIRED: Custom Hold-Tap Behavior (homerow_mod)
         * ---------------------------------------------------------------------
         * Error: Behavior &homerow_mod ... needs manual conversion.
         *
         * Parameters & Timings:
         * - Compatible: "zmk,behavior-hold-tap"
         * - Flavor: "balanced"
         *     -> If another key is pressed and released within tapping-term-ms, the hold (modifier) action is sent.
         * - Tapping Term: 200 ms (tapping-term-ms = <200>)
         *     -> Threshold window to differentiate between tapping a key and holding it as a modifier.
         * - Require Prior Idle: 125 ms (require-prior-idle-ms = <125>)
         *     -> Must be idle for 125ms before hold can activate; prevents accidental modifiers during fast typing.
         * - Bindings: <&kp>, <&kp> (Hold = Modifier key, Tap = Character key)
         *
         * How to configure manually:
         * Create a Hold-Tap / Mod-Tap behavior profile in the software with:
         * - Flavor: Balanced
         * - Tapping Term: 200 ms
         * - Require Prior Idle: 125 ms
         */
        /*
        homerow_mod: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
        */

        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_SCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            /*
             * MANUAL CONVERSION REQUIRED - HOMEROW MODS (Layer 0):
             * The following 8 homerow mod keys were replaced with default key presses (&kp <KEY>)
             * so the keymap can be imported into the configuration software:
             *
             * Settings to configure manually for each key (Hold-Tap / Mod-Tap):
             *   - Flavor: balanced
             *   - Tapping term: 200 ms
             *   - Require prior idle: 125 ms
             *
             * Key-by-key hold/tap mapping:
             *   - Key A:         Hold = LEFT_SHIFT    | Tap = A          (Original: &homerow_mod LEFT_SHIFT A)
             *   - Key S:         Hold = LEFT_CONTROL  | Tap = S          (Original: &homerow_mod LEFT_CONTROL S)
             *   - Key D:         Hold = LEFT_ALT      | Tap = D          (Original: &homerow_mod LEFT_ALT D)
             *   - Key F:         Hold = LEFT_GUI      | Tap = F          (Original: &homerow_mod LEFT_GUI F)
             *   - Key J:         Hold = LEFT_GUI      | Tap = J          (Original: &homerow_mod LEFT_GUI J)
             *   - Key K:         Hold = RIGHT_ALT     | Tap = K          (Original: &homerow_mod RIGHT_ALT K)
             *   - Key L:         Hold = RIGHT_CONTROL | Tap = L          (Original: &homerow_mod RIGHT_CONTROL L)
             *   - Key SEMICOLON: Hold = RIGHT_SHIFT   | Tap = SEMICOLON  (Original: &homerow_mod RIGHT_SHIFT SEMICOLON)
             */
            bindings = <
&kp GRAVE  &kp N1  &kp N2            &kp N3    &kp N4            &kp N5                                           &kp N6   &kp N7               &kp N8     &kp N9     &kp N0         &kp GRAVE
&kp ESC    &kp Q   &kp W             &kp E     &kp R             &kp T                                            &kp Y    &kp U                &kp I      &kp O      &kp P          &kp BSPC
&kp TAB    &kp A   &kp S             &kp D     &kp F             &kp G                                            &kp H    &kp J                &kp K      &kp L      &kp SEMICOLON  &kp SQT
&kp LSHFT  &kp Z   &kp X             &kp C     &kp V             &kp B      &kp C_PLAY_PAUSE    &kp C_PLAY_PAUSE  &kp N    &kp M                &kp COMMA  &kp DOT    &kp FSLH       &kp RSHFT
                   &kp LEFT_CONTROL  &kp LALT  &kp LEFT_COMMAND  &mo LOWER  &kp SPACE           &kp RET           &lt RAISE BACKSPACE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        symbols {
            display-name = "lower";
            /*
             * MANUAL CONVERSION REQUIRED - CAPS WORD (Layer 1):
             * Replaced &caps_word with default key press &kp CAPS.
             *
             * Manual configuration details:
             *   - Original behavior: &caps_word
             *   - Behavior type: Caps Word
             *   - Behavior: Automatically capitalizes alpha keys until a word boundary
             *     (space, punctuation, number, enter) or idle timeout occurs.
             *   - How to configure manually: In software, assign this key to the "Caps Word"
             *     behavior or macro.
             */
            bindings = <
&kp CAPS   &kp F1         &kp F2                &kp F3             &kp F4                 &kp F5                           &kp F6        &kp F7            &kp F8          &kp F9             &kp F10      &kp F11
&none      &kp SQT        &kp LESS_THAN         &kp DOLLAR         &kp GREATER_THAN       &kp HASH                         &kp PERCENT   &kp LEFT_BRACKET  &kp UNDERSCORE  &kp RIGHT_BRACKET  &kp AT_SIGN  &kp F12
&none      &kp BACKSLASH  &kp LEFT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp COLON                        &kp CARET     &kp LEFT_BRACE    &kp EQUAL       &kp RIGHT_BRACE    &kp SLASH    &trans
&trans     &kp TILDE      &kp EXCLAMATION       &kp MINUS          &kp PLUS               &kp SEMICOLON  &trans    &trans  &kp ASTERISK  &kp AMPERSAND     &kp COMMA       &kp PERIOD         &kp PIPE     &trans
                          &trans                &trans             &trans                 &trans         &trans    &trans  &trans        &trans            &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        navigation {
            display-name = "raise";
            bindings = <
&none           &none           &none             &none         &none         &none                             &trans           &trans                &trans     &trans                 &trans   &trans
&trans          &kp INS         &kp PSCRN         &kp K_CMENU   &trans        &trans                            &kp PG_UP        &kp LG(LEFT_BRACKET)  &kp UP     &kp LG(RIGHT_BRACKET)  &none    &trans
&kp LEFT_SHIFT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp CLCK                          &kp PG_DN        &kp LEFT              &kp DOWN   &kp RIGHT              &kp DEL  &kp BSPC
&trans          &kp LG(Z)       &kp LG(X)         &kp LG(C)     &kp LG(V)     &studio_unlock  &trans    &trans  &kp EXCLAMATION  &kp QUESTION          &kp COMMA  &kp PERIOD             &trans   &trans
                                &trans            &trans        &trans        &trans          &trans    &trans  &trans           &trans                &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        adjust_layer {
            display-name = "adjust";
            /*
             * MANUAL CONVERSION REQUIRED - EXTERNAL POWER TOGGLE (Layer 3):
             * Replaced &ext_power EP_TOG with default key press &kp C_POWER.
             *
             * Manual configuration details:
             *   - Original behavior: &ext_power EP_TOG
             *   - Behavior type: External Power Control
             *   - Command: EP_TOG (External Power Toggle)
             *   - Behavior: Toggles the VCC power rail to OLED displays and RGB LEDs to save battery power.
             *   - How to configure manually: In software, assign this key to "External Power" -> "Toggle" (EP_TOG).
             */
            bindings = <
&bt BT_CLR   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none  &none  &none  &none  &none  &none
&none  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &none  &none  &none  &none  &none  &none
&none        &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none  &none  &none  &none  &none  &none
&none        &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &none  &none  &none  &none  &none  &none  &none
                              &none            &none            &none            &none            &none              &none  &none  &none  &none  &none
            >;
        };
    };
};
